# Copy to .env and fill in. .env is gitignored - never commit real values.

# Optional AO3 account credentials - unlocks works restricted to registered
# users. Leave both blank to fetch anonymously.
AO3_USERNAME=
AO3_PASSWORD=

# Where the Extract Text tab's "Saved for later" library (data/texts/<slug>/
# book.json) lives. Defaults to 'data/texts' inside this repo. This is purely
# a workspace for staging extracted text ahead of speech generation - it is
# not shared with the sibling story-recs repo, which owns its own separate
# data/texts/ staging area (with its own review/taste-profiling data) and
# fetches from book_converter's CLI/API on demand rather than sharing a
# folder with it.
EXTRACTED_TEXTS_FOLDER=

# Optional Audiobookshelf connection - only needed to use the media-library
# import features (Organization tab). Leave both blank to disable them.
AUDIOBOOKSHELF_URL=
AUDIOBOOKSHELF_API_KEY=

# How to reach the library folder(s) Audiobookshelf reports, when importing
# a staged audiobook: 'local' (default), 'nas', or 'smb'. book_converter runs
# on macOS/Windows/Linux, so 'smb' - which needs no OS mount and no elevated
# privileges - is the right choice unless you're specifically on Linux with
# an existing (or easily root-mountable) share.
#
# 'local' assumes the folder path Audiobookshelf reports is directly usable
# from this machine as-is (same host as Audiobookshelf, or an identical
# mount) - nothing further to configure.
#
# 'nas' (Linux only) is for a share mounted at OS level at a *different*
# local path than Audiobookshelf reports for it. Needs root to mount (see
# `book-converter-setup-mount-user`, which creates an unprivileged user with
# a narrowly-scoped sudo grant for exactly this) - run book_converter as
# that user. AUDIOBOOKSHELF_PATH_MAP translates Audiobookshelf's reported
# path to this machine's local mount path, as comma-separated
# remote-prefix=local-prefix pairs:
#   AUDIOBOOKSHELF_PATH_MAP=/audiobooks=/mnt/nas/audiobooks
# AUDIOBOOKSHELF_NAS_MOUNTS then lets book_converter mount that share itself
# (via the 'register' endpoint/button) instead of requiring it already
# mounted by hand: one 'local-mount-point|fs_type|remote' or
# 'local-mount-point|fs_type|remote|opt1,opt2' entry per ';'-separated
# section - local-mount-point must match a value on the right of
# AUDIOBOOKSHELF_PATH_MAP above, e.g.:
#   AUDIOBOOKSHELF_NAS_MOUNTS=/mnt/nas/audiobooks|cifs|//nas.local/audiobooks|username=svc,password=secret,vers=3.0
# A mount point with no entry here just can't be auto-mounted - it still
# works fine if it's already mounted some other way (e.g. /etc/fstab).
#
# 'smb' speaks SMB2/3 directly (no OS mount, no elevated privileges) - needs
# AUDIOBOOKSHELF_SMB_SERVER/USERNAME/PASSWORD (and optionally _PORT, default
# 445). AUDIOBOOKSHELF_SMB_SERVER is just the SMB host (e.g. a NAS's IP) -
# there's no separate share setting, because which share a path belongs to
# is derived from the path itself: the first path segment is taken as the
# share name (so Audiobookshelf reporting a folder path of '/audiobooks'
# means a share literally named 'audiobooks', which is how a NAS typically
# exposes each library folder). AUDIOBOOKSHELF_PATH_MAP is only needed for
# the rarer case where Audiobookshelf's reported path doesn't already look
# like that - it remaps a path (or prefix of one) to the 'share/subpath'
# shape, e.g. if Audiobookshelf reports '/mnt/audiobooks' for a share
# actually named 'audiobooks':
#   AUDIOBOOKSHELF_PATH_MAP=/mnt/audiobooks=/audiobooks
AUDIOBOOKSHELF_STORAGE=local
AUDIOBOOKSHELF_PATH_MAP=

AUDIOBOOKSHELF_NAS_MOUNTS=

AUDIOBOOKSHELF_SMB_SERVER=
AUDIOBOOKSHELF_SMB_USERNAME=
AUDIOBOOKSHELF_SMB_PASSWORD=
AUDIOBOOKSHELF_SMB_PORT=
